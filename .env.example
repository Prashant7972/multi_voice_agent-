# Ollama Configuration (Port 11435 from systemd override has both models installed)
OLLAMA_HOST=http://127.0.0.1:11435
LLM_MODEL=gemma3:4b

# Voice Assistant Identity & System Prompt
SYSTEM_PROMPT="You are a helpful local voice assistant powered by Gemma 3, running completely offline on this computer. You are NOT ChatGPT and you are NOT made by OpenAI. Your model is Gemma 3. Keep your answers short and conversational (1 to 3 sentences maximum). Do not use markdown, bullet points, asterisks, or code blocks. Speak naturally as if talking out loud."

# Speech-To-Text (faster-whisper)
WHISPER_MODEL_NAME=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Text-To-Speech (Piper)
PIPER_VOICE_NAME=en_US-lessac-medium

# Audio Hardware Devices
ALSA_INPUT_DEVICE=hw:3,0
ALSA_OUTPUT_DEVICE=plughw:2,0

# Voice Activity Detection (Silero VAD)
VAD_THRESHOLD=0.40
SILENCE_DURATION_THRESHOLD=1.0

# Twilio Voice Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_WEBHOOK_URL=

# ============================================================
# SMTP Email Verification & Password Recovery Settings
# ============================================================
# SMTP Server hostname (e.g., smtp.gmail.com, smtp.office365.com, smtp.sendgrid.net)
SMTP_HOST=
# SMTP Port: 587 for STARTTLS (recommended) or 465 for SSL
SMTP_PORT=587
# Authentication username / email
SMTP_USER=
# Authentication password (e.g. Gmail App Password, SendGrid API key)
SMTP_PASSWORD=
# Sender From Address (e.g. no-reply@yourcompany.com)
SMTP_FROM=no-reply@apexai.io
# Enable TLS encryption (true for port 587, false if using port 465 direct SSL)
SMTP_TLS=true

